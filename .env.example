# Copy to .env for local overrides (never commit .env).
# Defaults match docker-compose.yml — change only if ports/credentials collide.

RESOURCE_DB_NAME=resource_db
RESOURCE_DB_USER=resource
RESOURCE_DB_PASSWORD=resource
RESOURCE_DB_PORT=5432

BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking
BOOKING_DB_PASSWORD=booking
BOOKING_DB_PORT=5433

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=payment
PAYMENT_DB_PORT=5434

# Keycloak (admin console: http://localhost:8180)
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/creative-space

# Demo users (imported realm): demo/demo (USER), admin-user/admin (USER+ADMIN)
# Public client id for password-grant demos: creative-space-public

KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=notification
NOTIFICATION_DB_PORT=5435

ZIPKIN_PORT=9411
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
TRACING_SAMPLING_PROBABILITY=1.0
